<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.yasith.wag-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HERE@/bin/wag-sync</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/wag-sync.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/wag-sync.log</string>
</dict>
</plist>
